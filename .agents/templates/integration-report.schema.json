{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://media-sync.local/schemas/integration-report.schema.json",
    "title": "Media Sync final integration report",
    "description": "Versioned contract for a fresh final review of an exact archived integration candidate.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "reportKind",
        "reportId",
        "changeId",
        "reviewer",
        "workOrder",
        "acceptedArtifactDigest",
        "git",
        "scenarioMatrix",
        "conventionMatrix",
        "expectedCommits",
        "orderedIntegrations",
        "fileOperations",
        "commands",
        "requiredChecks",
        "reviewReferences",
        "evidenceReferences",
        "evidenceOnlyCommitValidation",
        "findings",
        "finalVerdict",
        "acceptedRisks",
        "mergeEligibility"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "reportKind": {
            "const": "final-integration-review"
        },
        "reportId": {
            "$ref": "#/$defs/identifier"
        },
        "changeId": {
            "$ref": "#/$defs/identifier"
        },
        "reviewer": {
            "$ref": "#/$defs/reviewer"
        },
        "workOrder": {
            "$ref": "#/$defs/workOrderReference"
        },
        "acceptedArtifactDigest": {
            "$ref": "#/$defs/sha256"
        },
        "git": {
            "$ref": "#/$defs/gitIdentity"
        },
        "scenarioMatrix": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/scenarioResult"
            }
        },
        "conventionMatrix": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/conventionResult"
            }
        },
        "expectedCommits": {
            "description": "The exact first-parent commit sequence from the accepted master baseline through the archived candidate.",
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/expectedCommit"
            }
        },
        "orderedIntegrations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/orderedIntegration"
            }
        },
        "fileOperations": {
            "description": "The complete accepted-master-baseline-to-candidate file-operation inventory; the work order separately authorizes its base-to-candidate operations.",
            "$ref": "#/$defs/fileOperationInventory"
        },
        "commands": {
            "description": "The exact ordered integration-checkpoint command results, bound to the active work order.",
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/checkpointCommandResult"
            }
        },
        "requiredChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/requiredCheck"
            }
        },
        "reviewReferences": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/reviewReference"
            }
        },
        "evidenceReferences": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/evidenceReference"
            }
        },
        "evidenceOnlyCommitValidation": {
            "$ref": "#/$defs/evidenceOnlyCommitValidation"
        },
        "findings": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/finding"
            }
        },
        "finalVerdict": {
            "enum": ["pass", "changes-required", "pass-with-accepted-risks"]
        },
        "acceptedRisks": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/acceptedRisk"
            }
        },
        "mergeEligibility": {
            "$ref": "#/$defs/mergeEligibility"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "finalVerdict": {
                        "const": "pass-with-accepted-risks"
                    }
                },
                "required": ["finalVerdict"]
            },
            "then": {
                "properties": {
                    "acceptedRisks": {
                        "minItems": 1
                    }
                }
            },
            "else": {
                "properties": {
                    "acceptedRisks": {
                        "maxItems": 0
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "finalVerdict": {
                        "const": "changes-required"
                    }
                },
                "required": ["finalVerdict"]
            },
            "then": {
                "properties": {
                    "findings": {
                        "minItems": 1
                    }
                }
            }
        }
    ],
    "$defs": {
        "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "repoPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
        },
        "workingDirectory": {
            "anyOf": [
                {
                    "const": "."
                },
                {
                    "$ref": "#/$defs/repoPath"
                }
            ]
        },
        "reviewer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewerId", "role", "reviewedAt"],
            "properties": {
                "reviewerId": {
                    "$ref": "#/$defs/identifier"
                },
                "role": {
                    "const": "fresh-integration-reviewer"
                },
                "reviewedAt": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "workOrderReference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workOrderId", "workOrderDigest"],
            "properties": {
                "workOrderId": {
                    "$ref": "#/$defs/identifier"
                },
                "workOrderDigest": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "gitIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "baselineSha",
                "reviewedImplementationSha",
                "finalArchiveSha",
                "candidateSha",
                "candidateTreeSha",
                "rawDiffSha256"
            ],
            "properties": {
                "baselineSha": {
                    "description": "The original accepted master baseline recorded by acceptance.json.",
                    "$ref": "#/$defs/sha1"
                },
                "reviewedImplementationSha": {
                    "description": "The subject SHA of exactly one resolved passing implementation review reference.",
                    "$ref": "#/$defs/sha1"
                },
                "finalArchiveSha": {
                    "$ref": "#/$defs/sha1"
                },
                "candidateSha": {
                    "$ref": "#/$defs/sha1"
                },
                "candidateTreeSha": {
                    "$ref": "#/$defs/sha1"
                },
                "rawDiffSha256": {
                    "description": "SHA-256 of the canonical git diff --binary --full-index --no-ext-diff --no-textconv --find-renames=50% --diff-algorithm=default --no-indent-heuristic output from the accepted master baseline to the archived candidate.",
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "evidenceText": {
            "type": "string",
            "minLength": 1
        },
        "scenarioResult": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement", "scenario", "status", "evidence"],
            "properties": {
                "requirement": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "scenario": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "status": {
                    "enum": ["pass", "fail", "not-applicable"]
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/evidenceText"
                    }
                }
            }
        },
        "conventionResult": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conventionId", "status", "evidence"],
            "properties": {
                "conventionId": {
                    "type": "string",
                    "pattern": "^[A-Z]+-[0-9]{2}$"
                },
                "status": {
                    "enum": ["pass", "fail", "not-applicable"]
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/evidenceText"
                    }
                }
            }
        },
        "expectedCommit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "sha", "description"],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1
                },
                "sha": {
                    "$ref": "#/$defs/sha1"
                },
                "description": {
                    "$ref": "#/$defs/nonEmptyString"
                }
            }
        },
        "rename": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
                "from": {
                    "$ref": "#/$defs/repoPath"
                },
                "to": {
                    "$ref": "#/$defs/repoPath"
                }
            }
        },
        "fileOperationInventory": {
            "type": "object",
            "additionalProperties": false,
            "required": ["additions", "modifications", "deletions", "renames"],
            "properties": {
                "additions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/repoPath"
                    }
                },
                "modifications": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/repoPath"
                    }
                },
                "deletions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/repoPath"
                    }
                },
                "renames": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/rename"
                    }
                }
            }
        },
        "orderedIntegration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sequence",
                "integrationId",
                "expectedCommitSha",
                "workOrderId",
                "workOrderDigest",
                "sourceSubjectSha",
                "sourceTreeSha",
                "fileOperations"
            ],
            "properties": {
                "sequence": {
                    "type": "integer",
                    "minimum": 1
                },
                "integrationId": {
                    "$ref": "#/$defs/identifier"
                },
                "expectedCommitSha": {
                    "description": "A unique commit in increasing first-parent order whose parent-to-commit file-operation inventory exactly matches both this entry and the referenced review.",
                    "$ref": "#/$defs/sha1"
                },
                "workOrderId": {
                    "$ref": "#/$defs/identifier"
                },
                "workOrderDigest": {
                    "$ref": "#/$defs/sha256"
                },
                "sourceSubjectSha": {
                    "$ref": "#/$defs/sha1"
                },
                "sourceTreeSha": {
                    "$ref": "#/$defs/sha1"
                },
                "fileOperations": {
                    "description": "The exact inventory shared by the resolved implementation review and expectedCommitSha's first-parent delta.",
                    "$ref": "#/$defs/fileOperationInventory"
                }
            }
        },
        "checkpointCommandResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commandId",
                "cwd",
                "executable",
                "arguments",
                "exitCode",
                "stdoutSha256",
                "stderrSha256",
                "outcome"
            ],
            "properties": {
                "commandId": {
                    "$ref": "#/$defs/identifier"
                },
                "cwd": {
                    "$ref": "#/$defs/workingDirectory"
                },
                "executable": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "arguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exitCode": {
                    "type": "integer"
                },
                "stdoutSha256": {
                    "$ref": "#/$defs/sha256"
                },
                "stderrSha256": {
                    "$ref": "#/$defs/sha256"
                },
                "outcome": {
                    "enum": ["pass", "fail"]
                }
            }
        },
        "commandResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "cwd",
                "executable",
                "arguments",
                "exitCode",
                "stdoutSha256",
                "stderrSha256"
            ],
            "properties": {
                "cwd": {
                    "$ref": "#/$defs/workingDirectory"
                },
                "executable": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "arguments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exitCode": {
                    "type": "integer"
                },
                "stdoutSha256": {
                    "$ref": "#/$defs/sha256"
                },
                "stderrSha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "requiredCheck": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkId", "outcome", "result", "evidence"],
            "properties": {
                "checkId": {
                    "$ref": "#/$defs/identifier"
                },
                "outcome": {
                    "enum": ["pass", "fail"]
                },
                "result": {
                    "$ref": "#/$defs/commandResult"
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                }
            }
        },
        "reviewReference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "reportId",
                "reportSha256",
                "workOrderDigest",
                "subjectSha",
                "subjectTreeSha",
                "verdict",
                "evidencePath"
            ],
            "properties": {
                "reportId": {
                    "$ref": "#/$defs/identifier"
                },
                "reportSha256": {
                    "$ref": "#/$defs/sha256"
                },
                "workOrderDigest": {
                    "$ref": "#/$defs/sha256"
                },
                "subjectSha": {
                    "$ref": "#/$defs/sha1"
                },
                "subjectTreeSha": {
                    "$ref": "#/$defs/sha1"
                },
                "verdict": {
                    "enum": ["pass", "pass-with-accepted-risks"]
                },
                "evidencePath": {
                    "$ref": "#/$defs/repoPath"
                }
            }
        },
        "evidenceReference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "sha256", "subjectSha"],
            "properties": {
                "kind": {
                    "enum": ["work-order", "checkpoint", "review-report"]
                },
                "path": {
                    "$ref": "#/$defs/repoPath"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "subjectSha": {
                    "$ref": "#/$defs/sha1"
                }
            }
        },
        "evidenceOnlyCommitValidation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "commitSha",
                "parentSha",
                "expectedEvidencePaths",
                "fileOperations",
                "validatorResult",
                "outcome"
            ],
            "properties": {
                "commitSha": {
                    "$ref": "#/$defs/sha1"
                },
                "parentSha": {
                    "$ref": "#/$defs/sha1"
                },
                "expectedEvidencePaths": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/repoPath"
                    }
                },
                "fileOperations": {
                    "$ref": "#/$defs/fileOperationInventory"
                },
                "validatorResult": {
                    "$ref": "#/$defs/commandResult"
                },
                "outcome": {
                    "enum": ["pass", "fail"]
                }
            }
        },
        "findingEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "lineStart", "lineEnd", "detail"],
            "properties": {
                "path": {
                    "$ref": "#/$defs/repoPath"
                },
                "lineStart": {
                    "type": "integer",
                    "minimum": 1
                },
                "lineEnd": {
                    "type": "integer",
                    "minimum": 1
                },
                "detail": {
                    "$ref": "#/$defs/nonEmptyString"
                }
            }
        },
        "finding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["findingId", "severity", "status", "title", "description", "evidence"],
            "properties": {
                "findingId": {
                    "$ref": "#/$defs/identifier"
                },
                "severity": {
                    "enum": ["blocking", "major", "minor", "note"]
                },
                "status": {
                    "enum": ["open", "resolved", "accepted-risk"]
                },
                "title": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "description": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/findingEvidence"
                    }
                }
            }
        },
        "acceptedRisk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "riskId",
                "findingId",
                "coordinatorId",
                "acceptedAt",
                "rationale",
                "followUpDisposition"
            ],
            "properties": {
                "riskId": {
                    "$ref": "#/$defs/identifier"
                },
                "findingId": {
                    "$ref": "#/$defs/identifier"
                },
                "coordinatorId": {
                    "$ref": "#/$defs/identifier"
                },
                "acceptedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "rationale": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "followUpDisposition": {
                    "$ref": "#/$defs/nonEmptyString"
                }
            }
        },
        "mergeEligibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "eligible",
                "method",
                "expectedMasterSha",
                "candidateSha",
                "checkedAt",
                "blockers"
            ],
            "properties": {
                "eligible": {
                    "type": "boolean"
                },
                "method": {
                    "const": "ff-only"
                },
                "expectedMasterSha": {
                    "$ref": "#/$defs/sha1"
                },
                "candidateSha": {
                    "$ref": "#/$defs/sha1"
                },
                "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "blockers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "eligible": {
                                "const": true
                            }
                        },
                        "required": ["eligible"]
                    },
                    "then": {
                        "properties": {
                            "blockers": {
                                "maxItems": 0
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "blockers": {
                                "minItems": 1
                            }
                        }
                    }
                }
            ]
        }
    }
}
