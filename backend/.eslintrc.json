{
    "root": true,
    "env": {
        "node": true,
        "es2020": true,
        "jest": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": ["prettier", "perfectionist", "import"],
    "extends": ["plugin:prettier/recommended"],
    "rules": {
        "no-unused-vars": "off",
        "prefer-const": "error",
        "no-var": "error",
        "no-restricted-imports": [
            "error",
            {
                "patterns": [
                    {
                        "group": [
                            "./*/*",
                            "../*/*",
                            "@/*/*",
                            "!../../**",
                            "!@/*/repositories",
                            "!@/infrastructure/database"
                        ],
                        "message": "Use the folder barrel import (index.ts) instead of deep file imports. The only permitted sub-barrels are `@/<feature>/repositories` (port contracts) and `@/infrastructure/database` (DatabaseModule) — imported deeply on purpose so a composition root takes a contract without pulling the feature's Nest module into the graph (ARCH-04)."
                    }
                ]
            }
        ],
        "import/no-useless-path-segments": [
            "error",
            {
                "noUselessIndex": true
            }
        ],
        "perfectionist/sort-imports": [
            "error",
            {
                "type": "line-length",
                "order": "asc",
                "newlinesBetween": "always",
                "groups": [
                    "type",
                    "builtin",
                    "external",
                    ["internal-type", "internal"],
                    ["parent-type", "sibling-type", "index-type"],
                    ["parent", "sibling", "index"],
                    "object",
                    "unknown"
                ],
                "internalPattern": ["@/**"]
            }
        ],
        "perfectionist/sort-exports": [
            "error",
            {
                "type": "line-length",
                "order": "asc"
            }
        ],
        "perfectionist/sort-named-exports": [
            "error",
            {
                "type": "line-length",
                "order": "asc"
            }
        ]
    },
    "overrides": [
        {
            "files": ["test/**/*.ts", "src/**/*.spec.ts"],
            "rules": {
                "no-restricted-imports": "off"
            }
        }
    ]
}
