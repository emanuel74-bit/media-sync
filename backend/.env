MONGODB_URI=mongodb://admin:password@mongodb:27017/media-sync?authSource=admin
INGEST_MEDIAMTX_BASE_URL=http://sync:syncpass@mediamtx-ingest:9000
CLUSTER_MEDIAMTX_BASE_URL=http://sync:syncpass@mediamtx-cluster:9000
CLUSTER_MEDIAMTX_BASE_URLS=http://sync:syncpass@mediamtx-cluster:9000
# Port of the v3 API on registered cluster pods (clients are built per-pod by host).
CLUSTER_POD_MEDIAMTX_PORT=9000
# RTSP base the cluster nodes pull a relayed path from (credentials for ingest read auth).
INGEST_RTSP_URL=rtsp://sync:syncpass@mediamtx-ingest:8554
SYNC_POLL_INTERVAL=10000
METRICS_POLL_INTERVAL=5000
INSPECTION_INTERVAL=30000
POD_HEALTH_TOLERANCE_SECONDS=120
ALERT_BITRATE_DROP_PERCENT=30
ALERT_STALE_SECONDS=60
